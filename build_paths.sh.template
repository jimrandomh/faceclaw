# Copy this file to build_paths.sh and add any paths or other prelude needed
# before build. Other build scripts will `source` it.

#export JAVA_HOME=
#export ANDROID_HOME=
#export PATH=
#export ANDROID_KEYSTORE=
#export DEVICE_ID=
# Apple signing team for iOS device builds (Xcode > Settings > Accounts)
#export IOS_TEAM_ID=
# iOS bundle ID; set one your signing team owns to sideload alongside the
# official build (default com.faceclaw.app). Also used by the iOS config scripts.
#export IOS_BUNDLE_ID=
# Embed the Apple Watch app in the iOS app. Its link to the phone needs this, and
# signing it needs a watch registered to your team, so it's off by default.
#export FACECLAW_EMBED_WATCH=1
# Which Apple Watch build_apple_watch.sh --install targets (default: the first found)
#export APPLE_WATCH_DEVICE_ID=

