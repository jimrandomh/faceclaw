<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" actionBarHidden="true">
    <GridLayout rows="*,auto" class="p-20">
        <ScrollView row="0">
            <StackLayout>
                <Label text="Disconnect Other Apps" class="h1 text-center m-t-24" textWrap="true" />
                <Label
                    text="Faceclaw and the official Even Realities app can't both be connected to the glasses at once. Before continuing, open the Even app, go to Home, select your glasses, open the Connection submenu, and press Disconnect (or turn off the Even app's Bluetooth). If any other glasses app is installed (such as Mentra), disconnect it too."
                    class="body-text m-t-24" textWrap="true" />
                <Button text="Open Even App Settings" tap="{{ onOpenEvenAppSettingsTap }}" width="{{ settingsButtonWidth }}" horizontalAlignment="center" class="-primary m-t-24" />
            </StackLayout>
        </ScrollView>

        <GridLayout row="1" columns="*,*" class="m-t-20">
            <Button col="0" text="Back" tap="{{ onBackTap }}" />
            <Button col="1" text="Continue" tap="{{ onContinueTap }}" class="-primary" />
        </GridLayout>
    </GridLayout>
</Page>
