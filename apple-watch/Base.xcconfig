// Settings shared by every target of the watch project.
//
// The watch app is tied to the phone app by bundle ID: its own must begin with
// the phone app's, and WKCompanionAppBundleIdentifier must equal it, or
// WatchConnectivity has no counterpart. Local.xcconfig (not checked in) overrides
// this and sets the signing team; build_apple_watch.sh writes it from build_paths.sh.
FACECLAW_IOS_BUNDLE_ID = com.faceclaw.app

SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
// Observation (@Observable) needs watchOS 10: Series 6, SE 2, Ultra and later.
WATCHOS_DEPLOYMENT_TARGET = 10.0
SWIFT_VERSION = 5.0
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO

#include? "Local.xcconfig"
