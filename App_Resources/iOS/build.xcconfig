IPHONEOS_DEPLOYMENT_TARGET = 15.1;
TARGETED_DEVICE_FAMILY = 1;
CODE_SIGN_STYLE = Automatic;

// Select the local signing team in Xcode or pass --teamId to the iOS scripts.
OTHER_LDFLAGS = $(inherited) -framework CoreBluetooth -framework CoreLocation -framework CoreText -framework Speech -framework AVFoundation -framework WebKit -framework UniformTypeIdentifiers -framework ImageIO -framework EventKit

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;

HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../../App_Resources/iOS/src/lc3"
// NativeScript's xcconfig merge keeps only the CocoaPods HEADER_SEARCH_PATHS when the
// generated project is rebuilt, so the vendored liblc3 include dir is also passed as a flag
// (OTHER_CFLAGS merges like OTHER_LDFLAGS).
OTHER_CFLAGS = $(inherited) -I"$(SRCROOT)/../../App_Resources/iOS/src/lc3"

// FaceclawKit ships arm64 device and Apple-silicon simulator slices.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64;
