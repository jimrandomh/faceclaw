IPHONEOS_DEPLOYMENT_TARGET = 15.1;
TARGETED_DEVICE_FAMILY = 1;
CODE_SIGN_STYLE = Automatic;

// Select the local signing team in Xcode or pass --teamId to the iOS scripts.
OTHER_LDFLAGS = $(inherited) -framework CoreBluetooth -framework CoreText -framework Speech -framework AVFoundation

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;

HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../../App_Resources/iOS/src/lc3"
